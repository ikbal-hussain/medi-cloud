# Copy to .env for local development: cp .env.example .env
# Every setting is documented in src/config/env.ts.

# PostgreSQL. `docker compose up -d` (repo root) starts one with these credentials.
DATABASE_URL=postgresql://medi:medi@localhost:5432/medi_cloud

# Signs login tokens. Required when deployed; locally a dev-only fallback is used if empty.
JWT_SECRET=

# Port for `npm run dev`.
PORT=3000

# Browser origins allowed to call the API, comma-separated. `*` matches any characters,
# e.g. https://deploy-preview-*--medi-cloud-app.netlify.app. Locally, any localhost port is also allowed.
CORS_ORIGINS=https://medi-cloud-app.netlify.app

# Max login/register attempts per IP per 15 minutes (0 turns the limit off).
AUTH_RATE_LIMIT=20

# trace | debug | info | warn | error | silent
LOG_LEVEL=info
