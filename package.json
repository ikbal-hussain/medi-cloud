{
  "name": "medi-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, multi-tenant hospital management platform",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @medi-cloud/api\" \"npm run dev -w @medi-cloud/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:demo": "npm run init:demo -w @medi-cloud/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
